{
  "name": "nyxr-official-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node tools/verify-build.mjs",
    "build:vercel": "node tools/build-vercel.mjs",
    "build:release": "node tools/build-vercel.mjs --release",
    "check:release": "node tools/check-release.mjs",
    "test:deployment": "node --test tools/deployment.test.mjs",
    "qa:deployment": "node tools/qa-deployment.mjs",
    "qa:download-live": "node tools/qa-live-download.mjs",
    "prepare:deploy": "node tools/prepare-deploy.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "qa": "npm run test:deployment && npm run qa:deployment"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.4"
  }
}
